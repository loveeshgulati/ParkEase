# =====================================================
# SonarQube Configuration - ParkEase Backend (.NET 8)
# =====================================================

sonar.projectKey=parkease-backend
sonar.projectName=ParkEase Backend
sonar.projectVersion=1.0

# SonarQube server
sonar.host.url=http://localhost:9000
# Set your token here OR pass via -Dsonar.login on CLI
# sonar.login=<YOUR_BACKEND_TOKEN>

# Language
sonar.language=cs

# Sources (all microservices)
sonar.sources=ParkEase.Auth,ParkEase.Booking,ParkEase.ParkingLot,ParkEase.Payment,ParkEase.Spot,ParkEase.Vehicle,ParkEase.Notification

# Test project
sonar.tests=ParkEase.Tests

# Coverage report (OpenCover XML generated by coverlet)
sonar.cs.opencover.reportsPaths=coverage\coverage.opencover.xml

# Exclusions (generated/build artifacts)
sonar.exclusions=**/obj/**,**/bin/**,**/Migrations/**,**/*.Designer.cs
sonar.test.exclusions=**/obj/**,**/bin/**
sonar.coverage.exclusions=**/Migrations/**,**/*Program.cs,**/*Startup.cs

# Encoding
sonar.sourceEncoding=UTF-8
